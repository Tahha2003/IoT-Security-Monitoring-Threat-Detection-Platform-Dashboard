# ─────────────────────────────────────────────────────────────
# IoT Threat Detection Dashboard — Environment Configuration
# ─────────────────────────────────────────────────────────────
#
# Copy this file to .env and update the values to match your setup.
# NOTE: These values are baked into the React build at compile time.
#       After changing .env you must run `npm run build` again.
#
# ── LOCAL DEMO (default) ──────────────────────────────────────
# Run `node demo-server.js` then open http://localhost:3000
#
# REACT_APP_WS_URL=ws://localhost:8000/ws
# REACT_APP_API_URL=http://localhost:8000
# REACT_APP_PROM_URL=http://localhost:9090
#
# ── VERCEL / REMOTE DEPLOYMENT ───────────────────────────────
# Replace YOUR_VERCEL_URL with your actual deployment URL.
# Example: https://iot-security-dashboard.vercel.app
#
# REACT_APP_WS_URL=wss://YOUR_VERCEL_URL/ws
# REACT_APP_API_URL=https://YOUR_VERCEL_URL
# REACT_APP_PROM_URL=https://YOUR_VERCEL_URL
#
# ── REAL HARDWARE DEPLOYMENT ─────────────────────────────────
# Replace 192.168.1.20 with your backend PC's LAN IP.
#
# REACT_APP_WS_URL=ws://192.168.1.20:8000/ws
# REACT_APP_API_URL=http://192.168.1.20:8000
# REACT_APP_PROM_URL=http://192.168.1.20:9090

# Active config (local demo — matches pre-built dashboard/build):
REACT_APP_WS_URL=ws://localhost:8000/ws
REACT_APP_API_URL=http://localhost:8000
REACT_APP_PROM_URL=http://localhost:9090
